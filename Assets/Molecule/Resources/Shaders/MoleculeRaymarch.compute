#pragma kernel CSMain

RWTexture2D<float4> _Target;

struct Atom
{
    float3 position;
    uint element;
};

struct Bond
{
    uint atomA;
    uint atomB;
    float radius;
};

StructuredBuffer<Atom> _AtomBuffer;
StructuredBuffer<Bond> _BondBuffer;
StructuredBuffer<float4> _ElementColors;
StructuredBuffer<float> _ElementRadii;

int _AtomCount;
int _BondCount;
float4x4 _ViewMatrix;
float4x4 _ProjectionMatrix;
float4x4 _InverseViewMatrix;
float4x4 _InverseProjectionMatrix;
float3 _CameraPosition;
float3 _CameraForward;
float _AtomScale;
float _BondScale;

float3 _LightDirection;
float3 _LightColor;
float _AmbientIntensity;

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    _Target.GetDimensions(width, height);
    
    if (id.x >= width || id.y >= height)
        return;

    float2 uv = float2(id.xy) / float2(width, height);
    float2 screenPos = (uv - 0.5) * 2.0;
    
    // Create ray from camera
    float4 nearPoint = mul(_InverseProjectionMatrix, float4(screenPos, -1, 1));
    nearPoint /= nearPoint.w;
    nearPoint = mul(_InverseViewMatrix, nearPoint);
    
    float4 farPoint = mul(_InverseProjectionMatrix, float4(screenPos, 1, 1));
    farPoint /= farPoint.w;
    farPoint = mul(_InverseViewMatrix, farPoint);
    
    float3 rayOrigin = _CameraPosition;
    float3 rayDirection = normalize(farPoint.xyz - nearPoint.xyz);
    
    float minDistance = 99999.0;
    float3 finalColor = float3(0, 0, 0);
    float3 hitPoint = float3(0, 0, 0);
    float3 hitNormal = float3(0, 0, 0);
    bool hit = false;
    
    // Ray march atoms (spheres)
    for (int i = 0; i < _AtomCount; i++)
    {
        Atom atom = _AtomBuffer[i];
        float3 toSphere = rayOrigin - atom.position;
        float b = dot(toSphere, rayDirection);
        float c = dot(toSphere, toSphere) - pow(_ElementRadii[atom.element] * _AtomScale, 2);
        float discriminant = b * b - c;
        
        if (discriminant >= 0)
        {
            float t = -b - sqrt(discriminant);
            if (t > 0 && t < minDistance)
            {
                minDistance = t;
                hitPoint = rayOrigin + rayDirection * t;
                hitNormal = normalize(hitPoint - atom.position);
                finalColor = _ElementColors[atom.element].rgb;
                hit = true;
            }
        }
    }
    
    // Ray march bonds (capsules)
    for (int j = 0; j < _BondCount; j++)
    {
        Bond bond = _BondBuffer[j];
        if (bond.atomA >= (uint)_AtomCount || bond.atomB >= (uint)_AtomCount)
            continue;
            
        float3 posA = _AtomBuffer[bond.atomA].position;
        float3 posB = _AtomBuffer[bond.atomB].position;
        
        float3 ba = posB - posA;
        float3 oa = rayOrigin - posA;
        
        float baba = dot(ba, ba);
        float bard = dot(ba, rayDirection);
        float baoa = dot(ba, oa);
        float rdoa = dot(rayDirection, oa);
        float oaoa = dot(oa, oa);
        
        float a = baba - bard * bard;
        float b = baba * rdoa - baoa * bard;
        float c = baba * oaoa - baoa * baoa - bond.radius * bond.radius * _BondScale * _BondScale * baba;
        float h = b * b - a * c;
        
        if (h >= 0.0)
        {
            float t = (-b - sqrt(h)) / a;
            if (t > 0 && t < minDistance)
            {
                float y = baoa + t * bard;
                
                // Check if intersection is within the capsule cylinder
                if (y > 0.0 && y < baba)
                {
                    minDistance = t;
                    hitPoint = rayOrigin + rayDirection * t;
                    
                    // Calculate normal for cylinder part
                    float3 pa = oa + rayDirection * t;
                    // Project pa onto the bond axis and subtract to get radial direction
                    float3 projOnAxis = ba * (y / baba);
                    hitNormal = normalize(pa - projOnAxis);
                    
                    // Bond color (average of connected atoms)
                    float3 colorA = _ElementColors[_AtomBuffer[bond.atomA].element].rgb;
                    float3 colorB = _ElementColors[_AtomBuffer[bond.atomB].element].rgb;
                    finalColor = (colorA + colorB) * 0.5;
                    hit = true;
                }
            }
        }
    }
    
    float4 outputColor = float4(0, 0, 0, 1);
    
    if (hit)
    {
        // Simple lighting calculation
        float3 lightDir = normalize(-_LightDirection);
        float ndotl = max(0.0, dot(hitNormal, lightDir));
        
        float3 ambient = finalColor * _AmbientIntensity;
        float3 diffuse = finalColor * _LightColor * ndotl;
        
        outputColor.rgb = ambient + diffuse;
        outputColor.a = 1.0;
    }
    
    _Target[id.xy] = outputColor;
}
